@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Options
@using System.Text.Json
@model RazorClassBlog.Models.BlogPost;
@inject IOptions<BlogOptions> Options;
@inject IHttpContextAccessor HttpContextAccessor

@* 
  Custom JSON-LD for BlogPosting schema as needed
*@
@{
  string? heroImageUrl = Model.HeroImageUrl ?? Options.Value.DefaultOrganizationImageURL;
  var request = HttpContextAccessor.HttpContext?.Request;
  var blogUrl = Url.Page("Index", null, new { area = "Blog" }, protocol: request?.Scheme);

  var organizationName = Options.Value.DefaultOrganizationName;
  var authorName = Model.AuthorName ?? organizationName ?? "Unknown";
  var canonicalUrl = ViewData["canonical"]?.ToString();
  var description = ViewData["Description"]?.ToString();

  var published = Model.PublishedUtc ?? Model.CreatedUtc;
  var modified = Model.UpdatedUtc ?? published;

  // Maps the enum to the appropriate Schema.org type.
  var schemaType = Options.Value.ResolveBlogType(Model.BlogType);

  var article = new Dictionary<string, object?>
  {
    ["@context"] = "https://schema.org",
    ["@type"] = schemaType,
    ["@id"] = $"{canonicalUrl}#article",
    ["headline"] = Model.Title,
    ["description"] = description,
    ["url"] = canonicalUrl,
    ["mainEntityOfPage"] = new Dictionary<string, object?>
    {
      ["@type"] = "WebPage",
      ["@id"] = canonicalUrl
    },
    ["datePublished"] = published.UtcDateTime.ToString("O"),
    ["dateModified"] = modified.UtcDateTime.ToString("O"),
    ["inLanguage"] = "en-US",
    ["author"] = new Dictionary<string, object?>
    {
      ["@type"] = authorName == organizationName ? "Organization" : "Person",
      ["name"] = authorName
    },
    ["publisher"] = new Dictionary<string, object?>
    {
      ["@type"] = "Organization",
      ["name"] = organizationName,
      ["logo"] = new Dictionary<string, object?>
      {
        ["@type"] = "ImageObject",
        ["url"] = Options.Value.DefaultOrganizationImageURL
      }
    },
    ["isPartOf"] = new Dictionary<string, object?>
    {
      ["@type"] = "WebSite",
      ["name"] = Options.Value.PublicDisplayName,
      ["url"] = blogUrl
    }
  };

  if (!string.IsNullOrWhiteSpace(heroImageUrl))
  {
    article["image"] = new[] { heroImageUrl };
  }

  // Optional: Mark freely accessible articles.
  article["isAccessibleForFree"] = true;

  var json = JsonSerializer.Serialize(article, new JsonSerializerOptions
  {
    WriteIndented = true
  });
}

<script type="application/ld+json">
  @Html.Raw(json)
</script>