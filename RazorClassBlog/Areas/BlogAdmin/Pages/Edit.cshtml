@page "{id?}"
@using RazorClassBlog.EnumsandConstants
@model RazorClassBlog.Areas.BlogAdmin.EditModel

@{
	var isNew = string.IsNullOrEmpty(Model.Post.Id);
	var title = isNew ? "Create Blog Post" : "Edit Blog Post";
	ViewData["Title"] = title;
}

<h1 class="mt-3 mb-3">@title</h1>
@{
	var nowUtc = DateTimeOffset.UtcNow;
	var isScheduled = Model.Post.Status == BlogPostStatus.Published
										&& Model.Post.PublishedUtc.HasValue
										&& Model.Post.PublishedUtc.Value > nowUtc;
}

@if (isScheduled)
{
	<div class="alert alert-info mt-2">
		<strong>This post is scheduled.</strong>
		It will be visible on the public blog on
		<time class="js-local-time" datetime="@Model.Post.PublishedUtc!.Value.ToString("O")">@(Model.Post.PublishedUtc!.Value.ToString("yyyy-MM-dd h:mm tt"))</time>.
	</div>
}

<form method="post">
	<input type="hidden" asp-for="Post.Id" />
	<input type="hidden" asp-for="Post.BlogKey" />
	<input type="hidden" asp-for="Post.CreatedUtc" />

	<div class="row">
		<div class="col-lg-8">
			<div class="mb-3">
				<label asp-for="Post.Title" class="form-label"></label>&nbsp;<i class="small">with target keywords (kept < 60 characters)</i>
				<input asp-for="Post.Title" class="form-control" />
				<span asp-validation-for="Post.Title" class="text-danger"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Post.Slug" class="form-label">Slug</label>
				<input asp-for="Post.Slug" class="form-control" />
				<span class="form-text">
					Leave empty to auto-generate from the title. Used in the URL.
				</span>
			</div>

			<div class="mb-3">
				<label asp-for="Post.Summary" class="form-label"></label>&nbsp;<i class="small">~150-160 characters summarizing the content to drive clicks</i>
				<textarea asp-for="Post.Summary" class="form-control" rows="2"></textarea>
			</div>

			<div class="mb-3">
				<label asp-for="Post.Content" class="form-label">Content</label>
				@* This textarea will be transformed by TinyMCE *@
				<textarea asp-for="Post.Content" class="form-control" rows="15"></textarea>
				<span class="form-text">
					Use the editor to format your post. Content is stored as HTML.
				</span>
			</div>
		</div>

		<div class="col-lg-4">
			<div class="border rounded-3 p-3 mb-3 bg-light">
				<h2 class="h6 mb-3">Publishing</h2>

				<div class="mb-3">
					<label asp-for="Post.AuthorName" class="form-label">Author</label>
					<input asp-for="Post.AuthorName" class="form-control" />
					<span class="form-text">
						Shown on the post. Can be a person's name (e.g., "Jane Doe") or an entity
						(e.g., "Acme Marketing Team").
					</span>
					<span asp-validation-for="Post.AuthorName" class="text-danger"></span>
				</div>

				<div class="form-check form-switch mb-3">
					<input asp-for="Publish" class="form-check-input" id="publishToggle" />
					<label asp-for="Publish" class="form-check-label">Published</label>
					<div class="form-text">
						Turn this on to publish now or schedule for a future date.
					</div>
				</div>

				<div id="publishDateContainer" class="mb-3" style="display:none;">
					<label class="form-label">Publish date &amp; time</label>
					<input id="publishLocal" type="datetime-local" class="form-control" />
					<input type="hidden" asp-for="Post.PublishedUtc" />
					<span class="form-text">
						Leave as-is to publish immediately, or set a future time to schedule.
					</span>
					<div id="publishPastWarning" class="form-text text-warning mt-1" style="display:none;">
						Warning: publish date/time is in the past. This post will publish immediately.
					</div>
				</div>

				<div class="mb-3">
					<label class="form-label">Tags (comma-separated)</label>
					<input asp-for="TagsCsv" class="form-control" />
				</div>

				<div class="mb-3">
					<label asp-for="Post.HeroImageUrl" class="form-label">Hero image URL</label>
					<input asp-for="Post.HeroImageUrl" class="form-control" />
				</div>

				@if (Model.AvailablePostsForRelated.Count > 0)
				{
					<div class="mb-3">
						<label class="form-label">Related Articles</label>
						<div class="border rounded p-2" style="max-height:200px; overflow-y:auto;">
							@foreach (var available in Model.AvailablePostsForRelated)
							{
								var isChecked = Model.Post.RelatedPostIds?.Contains(available.Id) == true;
								<div class="form-check">
									<input class="form-check-input"
										   type="checkbox"
										   name="Post.RelatedPostIds"
										   value="@available.Id"
										   id="related_@available.Id"
										   @(isChecked ? "checked" : "") />
									<label class="form-check-label small" for="related_@available.Id">
										@available.Title
									</label>
								</div>
							}
						</div>
						<span class="form-text">Select posts to display as related articles at the bottom of this post.</span>
					</div>
				}
			</div>

			@if (Model.ImageUploadEnabled)
			{
				<div class="border rounded-3 p-3 mb-3 bg-light">
					<h2 class="h6 mb-3">Images</h2>

					@if (string.IsNullOrEmpty(Model.Post.Id))
					{
						<p class="text-muted small">Save the post first before uploading images.</p>
					}
					else
					{
						<div class="mb-2">
							<input type="file" name="UploadImage" class="form-control form-control-sm"
								   accept="image/*" form="uploadForm" />
						</div>
						<button type="submit" class="btn btn-sm btn-outline-primary" form="uploadForm">
							<i class="fa-solid fa-cloud-arrow-up"></i> Upload Image
						</button>

						@if (Model.UploadedImages.Count > 0)
						{
							<hr class="my-3" />
							<p class="small fw-semibold mb-2">Uploaded images</p>
							<ul class="list-unstyled mb-0">
								@foreach (var url in Model.UploadedImages)
								{
									<li class="mb-2">
										<img src="@url" alt="Uploaded image" class="img-thumbnail mb-1"
											 style="max-height:80px; max-width:100%;" />
										<div class="input-group input-group-sm">
											<input type="text" class="form-control form-control-sm js-copy-url"
												   value="@url" readonly />
											<button class="btn btn-outline-secondary btn-sm js-copy-btn" type="button"
													title="Copy URL">
												<i class="fa-solid fa-clipboard"></i>
											</button>
											<button class="btn btn-outline-danger btn-sm js-delete-image-btn" type="button"
													data-url="@url" title="Delete image">
												<i class="fa-solid fa-trash"></i>
											</button>
										</div>
									</li>
								}
							</ul>
						}
					}
				</div>
			}

			<div class="d-flex justify-content-between">
				<a asp-page="Index" class="btn btn-outline-secondary">
					Back to list
				</a>
				<button type="submit" class="btn btn-primary">
					Save
				</button>
			</div>
		</div>
	</div>
</form>

@* Separate upload form placed outside the main post form (nested forms are invalid HTML).
   The file input and submit button above reference this form via the `form="uploadForm"` attribute. *@
@if (Model.ImageUploadEnabled && !string.IsNullOrEmpty(Model.Post.Id))
{
	<form id="uploadForm" method="post" enctype="multipart/form-data" asp-page-handler="UploadImage">
		<input type="hidden" asp-for="Post.Id" />
		<input type="hidden" asp-for="Post.BlogKey" />
	</form>

	@* Hidden form used by the JS delete handler to POST blobUrl + Post.Id to OnPostDeleteImageAsync *@
	<form id="deleteImageForm" method="post" asp-page-handler="DeleteImage">
		<input type="hidden" asp-for="Post.Id" />
		<input type="hidden" asp-for="Post.BlogKey" />
		<input type="hidden" id="deleteImageBlobUrl" name="blobUrl" value="" />
	</form>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/lib/tinymce/tinymce.min.js"></script>

	<script>
		document.addEventListener("DOMContentLoaded", function () {

			// TinyMCE initialization (unchanged)
			tinymce.init({
					selector: 'textarea[name="Post.Content"]',
					height: 500,
					menubar: 'file edit view insert format tools table',
					powerpaste_allow_local_images: true,
					plugins: [
						'advlist', 'anchor', 'autolink', 'codesample', 'fullscreen', 'help',
						'image', 'lists', 'link', 'media', 'preview',
						'searchreplace', 'table', 'visualblocks', 'wordcount'
					],
					toolbar: 'undo redo | blocks fontfamily fontsize | ' +
										'bold italic underline strikethrough | forecolor backcolor | ' +
										'alignleft aligncenter alignright alignjustify | ' +
										'bullist numlist outdent indent blockquote | ' +
										'link image media table charmap emoticons | removeformat | help',
					toolbar_mode: 'sliding',
					spellchecker_dialog: true,
					spellchecker_ignore_list: ['Ephox', 'Moxiecode'],
					quickbars_selection_toolbar: 'bold italic underline | forecolor backcolor | blocks | quicklink blockquote',
					quickbars_insert_toolbar: 'image media table',
					image_title: true,
					image_caption: true,
					content_style: 'body { font-family: system-ui; font-size:14px }',
					license_key: 'gpl'
			});

			// Elements
			const publishToggle = document.getElementById("publishToggle");
			const dateContainer = document.getElementById("publishDateContainer");
			const publishUtc = document.getElementById("Post_PublishedUtc");
			const localInput = document.getElementById("publishLocal");
			const publishPastWarning = document.getElementById("publishPastWarning");
			const form = document.querySelector("form");
			let hasUserChangedPublishDate = false;
			let initialPublishLocalValue = "";

			// Utility: format current time for <input type="datetime-local">
			function getCurrentLocalDatetimeString(d) {
					let now = new Date();
					if(d != null && d != undefined) {
						now = d;
					}
					const pad = n => n.toString().padStart(2, "0");
					return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}` +
									`T${pad(now.getHours())}:${pad(now.getMinutes())}`;
			}

			// Initial state on load
			function refreshVisibility() {
					if (publishToggle.checked) {
							dateContainer.style.display = "";
							if(publishUtc.value) {
								const d = new Date(publishUtc.value);
								localInput.value = getCurrentLocalDatetimeString(d);
							} 
							if (!localInput.value) {
									localInput.value = getCurrentLocalDatetimeString();
							}
					} else {
							dateContainer.style.display = "none";
							localInput.value = "";
					}
			}

			function localToUtcIso() {
				// If publish isn't enabled, clear UTC
				if (publishToggle && !publishToggle.checked) {
					publishUtc.value = "";
					return;
				}

				// If local is empty, clear UTC
				if (!localInput.value) {
					publishUtc.value = "";
					return;
				}

				// Convert local datetime-local string to UTC ISO
				const d = new Date(localInput.value); // interpreted as local time
				publishUtc.value = isNaN(d.getTime()) ? "" : d.toISOString();
			}

			function isPastPublishSelection(localValue) {
				if (!localValue) return false;

				const selected = new Date(localValue);
				if (isNaN(selected.getTime())) return false;

				const now = new Date();
				const selectedDateOnly = new Date(selected.getFullYear(), selected.getMonth(), selected.getDate());
				const todayDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());

				if (selectedDateOnly < todayDateOnly) {
					return true;
				}

				if (selectedDateOnly.getTime() === todayDateOnly.getTime()) {
					return (now.getTime() - selected.getTime()) > (60 * 60 * 1000);
				}

				return false;
			}

			function refreshPastWarning() {
				if (!publishPastWarning) return;

				const dateChanged = localInput.value !== initialPublishLocalValue;
				const shouldWarn = publishToggle.checked && hasUserChangedPublishDate && dateChanged && isPastPublishSelection(localInput.value);
				publishPastWarning.style.display = shouldWarn ? "" : "none";
			}

			// Toggle logic
			publishToggle.addEventListener("change", function() {
				refreshVisibility();
				refreshPastWarning();
			});
			localInput.addEventListener("change", function() {
				hasUserChangedPublishDate = true;
				localToUtcIso();
				refreshPastWarning();
			});
			localInput.addEventListener("input", function() {
				hasUserChangedPublishDate = true;
				localToUtcIso();
				refreshPastWarning();
			});
			refreshVisibility(); // run on page load
			initialPublishLocalValue = localInput.value;
			refreshPastWarning();

			const autosaveIntervalMs = 30000; // every 30 seconds
			let autosaveTimer = null;
			let isSubmitting = false;
			let lastAutosaveLabel = null;

			// Small label to show autosave feedback
			function ensureAutosaveLabel() {
				if (!lastAutosaveLabel) {
						lastAutosaveLabel = document.createElement("div");
						lastAutosaveLabel.className = "small text-muted mt-2";
						// put it under the Save/Back buttons or wherever you like
						const buttonsRow = document.querySelector(".col-lg-4 .d-flex");
						if (buttonsRow) {
								buttonsRow.insertAdjacentElement("afterend", lastAutosaveLabel);
						}
				}
				return lastAutosaveLabel;
			}

			async function autosave() {
				if (isSubmitting) return; // don't autosave while a full submit is happening

				if (publishToggle.checked) {
					// Don't autosave when user has chosen to publish; force them to click Save for that
					return;
				}

				// Make sure TinyMCE content is pushed into the textarea
				if (tinymce && tinymce.get) {
						const editor = tinymce.get('Post_Content');
						if (editor) {
								editor.save(); // syncs editor -> textarea
						}
				}

				const label = ensureAutosaveLabel();
				label.textContent = "Autosaving...";

				const formData = new FormData(form);
				try {
						const response = await fetch("?handler=Autosave", {
								method: "POST",
								body: formData
						});

						if (!response.ok) {
								label.textContent = "Autosave failed (network error).";
								return;
						}

						const json = await response.json();

						if (json && json.id) {
								// Update hidden Id if it was a new post
								const idInput = document.querySelector('input[name="Post.Id"]');
								if (idInput && !idInput.value) {
										idInput.value = json.id;
								}

								const when = new Date().toLocaleTimeString();
								label.textContent = "Draft autosaved at " + when;
						}
						else {
								label.textContent = "Autosave completed.";
						}
				} catch (err) {
						console.error("Autosave error", err);
						label.textContent = "Autosave failed.";
				}
			}

			function startAutosave() {
					if (autosaveTimer) {
							clearInterval(autosaveTimer);
					}
					autosaveTimer = setInterval(autosave, autosaveIntervalMs);
			}

			// Start autosave when page is ready
			startAutosave();

			// Mark full submit so autosave doesn't interfere
			form.addEventListener("submit", function () {
					isSubmitting = true;
					if (autosaveTimer) {
							clearInterval(autosaveTimer);
					}
			});
		});
	</script>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			// Copy URL to clipboard
			document.querySelectorAll(".js-copy-btn").forEach(function (btn) {
				btn.addEventListener("click", function () {
					const input = btn.closest(".input-group").querySelector(".js-copy-url");
					if (!input) return;
					navigator.clipboard.writeText(input.value).then(function () {
						const icon = btn.querySelector("i");
						if (icon) {
							icon.classList.replace("fa-clipboard", "fa-check");
							setTimeout(function () { icon.classList.replace("fa-check", "fa-clipboard"); }, 1500);
						}
					}).catch(function () {
						input.select();
					});
				});
			});

			// Delete individual image
			document.querySelectorAll(".js-delete-image-btn").forEach(function (btn) {
				btn.addEventListener("click", function () {
					const url = btn.getAttribute("data-url");
					if (!url) return;
					if (!confirm("Delete this image? This cannot be undone.")) return;
					const urlInput = document.getElementById("deleteImageBlobUrl");
					const form = document.getElementById("deleteImageForm");
					if (urlInput && form) {
						urlInput.value = url;
						form.submit();
					}
				});
			});
		});
	</script>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			document.querySelectorAll("time.js-local-date, time.js-local-time")
				.forEach(function (el) {
					const iso = el.getAttribute("datetime");
					if (!iso) return;

					const d = new Date(iso);
					if (isNaN(d.getTime())) return;

					if (el.classList.contains("js-local-date")) {
						el.textContent = d.toLocaleDateString(undefined, {
							year: "numeric",
							month: "long",
							day: "numeric"
						});
					} else {
						el.textContent =
							d.toLocaleDateString(undefined, {
								year: "numeric",
								month: "long",
								day: "numeric"
							}) +
							" " +
							d.toLocaleTimeString(undefined, {
								hour: "numeric",
								minute: "2-digit"
							});
					}
				});
		});
	</script>
}
