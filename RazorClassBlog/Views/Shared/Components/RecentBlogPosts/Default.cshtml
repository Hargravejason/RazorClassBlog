@model RazorClassBlog.Models.RecentPostsWidgetModel

@if (Model.Posts.Count > 0)
{
  <section class="recent-blog-posts" aria-label="Recent blog posts">
    @if (string.Equals(Model.Layout, "horizontal", StringComparison.OrdinalIgnoreCase))
    {
      <div class="d-flex flex-column gap-3">
        @foreach (var post in Model.Posts)
        {
          var published = post.PublishedUtc ?? post.CreatedUtc;
          var postUrl = $"{Model.PublicRoutePrefix}/{published.Year:0000}/{published.Month:00}/{post.Slug}";

          <article class="card border-0 shadow-sm">
            <div class="row g-0 align-items-stretch">
              @if (!string.IsNullOrWhiteSpace(post.HeroImageUrl))
              {
                <div class="col-12 col-md-4">
                  <img src="@post.HeroImageUrl" class="img-fluid rounded-start w-100 h-100" style="object-fit:cover; min-height:160px;" alt="@post.Title" loading="lazy" decoding="async" />
                </div>
              }
              <div class="@(string.IsNullOrWhiteSpace(post.HeroImageUrl) ? "col-12" : "col-12 col-md-8")">
                <div class="card-body h-100">
                  <h2 class="h5 card-title mb-1">
                    <a href="@postUrl" class="text-decoration-none">@post.Title</a>
                  </h2>
                  <p class="text-muted small mb-2">@published.ToString("MMMM dd, yyyy")</p>
                  @if (!string.IsNullOrWhiteSpace(post.Summary))
                  {
                    <p class="card-text mb-0">@post.Summary</p>
                  }
                </div>
              </div>
            </div>
          </article>
        }
      </div>
    }
    else
    {
      <div class="row row-cols-1 row-cols-md-2 g-3">
        @foreach (var post in Model.Posts)
        {
          var published = post.PublishedUtc ?? post.CreatedUtc;
          var postUrl = $"{Model.PublicRoutePrefix}/{published.Year:0000}/{published.Month:00}/{post.Slug}";

          <article class="col">
            <div class="card h-100 border-0 shadow-sm">
              @if (!string.IsNullOrWhiteSpace(post.HeroImageUrl))
              {
                <div class="ratio ratio-16x9">
                  <img src="@post.HeroImageUrl" class="w-100 h-100" style="object-fit:cover;" alt="@post.Title" loading="lazy" decoding="async" />
                </div>
              }
              <div class="card-body">
                <h2 class="h5 card-title mb-1">
                  <a href="@postUrl" class="text-decoration-none">@post.Title</a>
                </h2>
                <p class="text-muted small mb-2">@published.ToString("MMMM dd, yyyy")</p>
                @if (!string.IsNullOrWhiteSpace(post.Summary))
                {
                  <p class="card-text mb-0">@post.Summary</p>
                }
              </div>
            </div>
          </article>
        }
      </div>
    }
  </section>
}
